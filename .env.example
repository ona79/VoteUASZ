# ============================================================
# VoteUASZ — Variables d'environnement (exemple de configuration)
# Copiez ce fichier en .env et remplissez les valeurs avant de lancer en local.
# NE JAMAIS committer le fichier .env réel dans Git.
# ============================================================

# --- Profil Spring Boot (dev | prod | test) ---
SPRING_PROFILES_ACTIVE=prod

# --- Base de données PostgreSQL ---
# En local avec docker-compose, ces valeurs correspondent aux variables du service postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/voteuasz_db
SPRING_DATASOURCE_USERNAME=uasz_admin
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe_postgres_securise_ici

# --- Sécurité JWT ---
# Clé de signature des tokens JWT (minimum 256 bits = 32 caractères)
# Générez-en une avec : openssl rand -base64 32
JWT_SECRET=votre_cle_secrete_jwt_min_256_bits_oblige

# --- Chiffrement AES-256 des bulletins ---
# Clé utilisée pour chiffrer les votes en AES-256-GCM (minimum 32 caractères)
# Générez-en une avec : openssl rand -base64 32
# NOTE : CRYPTO_SECRET_KEY a été supprimé — utilisez uniquement CRYPTO_SECRET
CRYPTO_SECRET=votre_cle_secrete_aes_256_min_32_chars

# --- Sel de hachage des IP dans le journal d'émargement ---
# Si absent, CRYPTO_SECRET est utilisé comme sel de repli
# Générez-en un avec : openssl rand -base64 32
AUDIT_IP_SALT=votre_sel_audit_ip_securise

# --- CORS : URL(s) du frontend autorisées ---
# En production : URL exacte de votre déploiement Vercel
# Plusieurs origines séparées par des virgules
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Envoi des codes OTP par e-mail (SMTP) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@voteuasz.sn
SPRING_MAIL_PASSWORD=votre_mot_de_passe_smtp_ou_cle_api
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true

# --- Mots de passe attribués aux comptes importés via CSV ---
# Communiqués aux utilisateurs lors de leur première connexion
# Doivent être forts (12+ caractères, maj, min, chiffre, symbole)
DEFAULT_ELECTEUR_PASSWORD=VOTRE_MOT_DE_PASSE_ELECTEUR_PAR_DEFAUT_ICI
DEFAULT_CANDIDAT_PASSWORD=VOTRE_MOT_DE_PASSE_CANDIDAT_PAR_DEFAUT_ICI

# --- Bootstrap du premier compte SUPER_ADMIN ---
# Utilisé une seule fois au premier démarrage si aucun SUPER_ADMIN n'existe en base.
# Le mot de passe doit respecter : 12+ car., 1 majuscule, 1 minuscule, 1 chiffre, 1 symbole.
# Après le premier démarrage réussi, vous pouvez supprimer ces variables (elles seront ignorées).
ADMIN_MATRICULE=ADMIN001
ADMIN_EMAIL=admin@voteuasz.sn
ADMIN_PASSWORD=VotreMotDePasseAdminStrong2026!
