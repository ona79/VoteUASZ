# Configuration PostgreSQL
POSTGRES_DB=voteuasz_db
POSTGRES_USER=uasz_admin
POSTGRES_PASSWORD=votre_mot_de_passe_postgres_securise_ici

# Configuration Backend Spring Boot
SPRING_PROFILES_ACTIVE=prod
# Clé JWT de 256 bits minimum (générée par exemple avec: openssl rand -base64 32)
JWT_SECRET=votre_cle_secrete_jwt_min_256_bits_oblige
# Clé AES de chiffrement des bulletins (générée par exemple avec: openssl rand -base64 32)
CRYPTO_SECRET=votre_cle_secrete_aes_256_bits
# Mots de passe attribués par défaut aux comptes importés via CSV (À DEFINIR EN PRODUCTION)
DEFAULT_ELECTEUR_PASSWORD=VOTRE_MOT_DE_PASSE_ELECTEUR_PAR_DEFAUT_ICI
DEFAULT_CANDIDAT_PASSWORD=VOTRE_MOT_DE_PASSE_CANDIDAT_PAR_DEFAUT_ICI
