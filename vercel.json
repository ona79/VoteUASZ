{
  "$schema": "https://openapi.vercel.com/vercel.json",
  "buildCommand": "cd frontend && npm ci && npx ng build --configuration production",
  "outputDirectory": "frontend/dist/voteuasz-frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://voteuasz-backend.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
